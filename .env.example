# Supabase PostgreSQL:
# - DATABASE_URL: Transaction pooler URI (port 6543) with ?pgbouncer=true
# - DIRECT_URL: Session/Direct URI (port 5432) for Prisma CLI & migrations
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security Secrets (generate strong random strings >= 32 chars in production)
AUTH_SECRET="dev-auth-secret-change-me-at-least-32-chars"
DEVICE_PEPPER="dev-device-pepper-change-me-at-least-32-chars"
P2P_QR_SECRET="dev-p2p-qr-secret-change-me-at-least-32-chars"

# Web Push VAPID (Populated in Phase 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
